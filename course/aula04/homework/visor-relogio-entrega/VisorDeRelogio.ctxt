comment4.text=\n\ Define\ a\ hora\ do\ visor\ de\ acordo\ com\ o\ valor\ de\ hora\ e\n\ minuto\ recebidos\ por\ par\u00E2metro.\n
comment5.params=
comment5.target=java.lang.String\ obterHora()
comment5.text=\n\ Retorna\ a\ hora\ atual\ do\ visor\ no\ formato\ HH\:MM\:SS.\n
